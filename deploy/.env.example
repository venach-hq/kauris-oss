# Copier en .env (jamais dans git) et remplir. Mots de passe : longs et aléatoires, par exemple
#   openssl rand -base64 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Version de Kauris (une étiquette publiée, par exemple 0.1.0 ; « latest » = la dernière).
# KAURIS_VERSION=latest

# Où Kauris répond : 127.0.0.1 = ce serveur seulement (derrière un proxy HTTPS) ;
# 0.0.0.0 = tout le réseau local (un poste du magasin qui sert les autres).
# KAURIS_ECOUTE=127.0.0.1
# KAURIS_PORT=8090

# Version modifiée de Kauris mise à disposition par le réseau : la licence AGPL-3.0 demande d'offrir son code
# source à vos utilisateurs ; mettez ici l'adresse de votre dépôt (lien « Code source » en bas des pages).
# KAURIS_CODE_SOURCE=https://github.com/venach-hq/kauris-oss
# Guide d'utilisation (lien « Aide ») ; par défaut celui du dépôt officiel.
# KAURIS_GUIDE=https://github.com/venach-hq/kauris-oss/blob/main/docs/guide
